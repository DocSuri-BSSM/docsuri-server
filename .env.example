# 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요. .env는 git에 커밋되지 않습니다.
# cp .env.example .env

# 필수 — 없으면 기동이 실패합니다
GEMINI_API_KEY=

# 선택 (기본값은 application.yaml 참고)
DB_USERNAME=postgres
DB_PASSWORD=postgres
GEMINI_MODEL_REASONING=gemini-3.6-flash
GEMINI_MODEL_FAST=gemini-3.6-flash

# gemini(실제 OCR) | mock(더미 데이터, 오프라인 개발/테스트용)
APP_OCR_PROVIDER=gemini
